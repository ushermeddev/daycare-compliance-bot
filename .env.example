# ── LINE Messaging API ─────────────────────────────────────────────────────────
# Get from: LINE Developers Console > your channel > Messaging API
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret

# LINE group ID for admin alert push messages
# How to get: add the bot to your group, send a message, check webhook logs for groupId
ADMIN_LINE_GROUP_ID=your_line_group_id

# ── Google Gemini ──────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key

# ── Supabase ───────────────────────────────────────────────────────────────────
# Get from: Supabase Dashboard > Project Settings > API
# IMPORTANT: use the service_role key (not anon key) — it bypasses RLS so the
# server can read/write all tables. Never expose this key to browsers or clients.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_SERVICE_ROLE_key

# ── App config ─────────────────────────────────────────────────────────────────
# Center UUID — copy from centers table after running schema.sql and inserting your center
CENTER_ID=your_center_uuid

# How often (minutes) the compliance engine scans for overdue records
COMPLIANCE_CHECK_INTERVAL_MINUTES=10
